# Copy to .env.local for local development. Never commit real values.

# Database (MongoDB Atlas)
MONGODB_URI=

# Auth (NextAuth). Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in codes (SMTP). Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Busundo <your-address@gmail.com>"

# Development only: set to false to disable the test accounts
# ENABLE_MOCK_LOGIN=false
